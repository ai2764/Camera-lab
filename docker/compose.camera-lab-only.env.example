# camera-lab-only mode config (point at your existing host ComfyUI).
# Your ComfyUI must be started with `--listen` (bind 0.0.0.0), else the container
# cannot reach it.
COMFYUI_URL=http://host.docker.internal:8188
# Your existing ComfyUI's input/ and output/ directories (absolute host paths):
COMFY_INPUT_DIR=C:/Users/AIBOX/dev/ComfyUI-scail/input
COMFY_OUTPUT_DIR=C:/Users/AIBOX/dev/ComfyUI-scail/output
# Host port for the Camera Lab UI:
CAMERA_LAB_PORT=8000
# Optional external LLM endpoint for the Casting tab:
LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=gpt-oss-20b
LLM_API_KEY=
