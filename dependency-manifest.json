{
  "schema_version": 1,
  "project": {
    "name": "camera-lab",
    "summary": "Local Python HTTP server and static web UI for driving ComfyUI video workflows."
  },
  "runtime": {
    "os": ["windows"],
    "python": ">=3.10",
    "entrypoint": "tools/camera_lab_server.py"
  },
  "commands": {
    "install_python_dependencies": "python -m pip install -r requirements.txt",
    "check_setup": ".\\scripts\\check_setup.ps1",
    "start": ".\\scripts\\start_camera_lab.ps1 -Open",
    "stop": ".\\scripts\\stop_camera_lab.ps1",
    "test": "python -m pytest -p no:cacheprovider tests/test_director_reference.py"
  },
  "local_config": {
    "template": ".env.example",
    "ignored_file": ".env",
    "required_env": {
      "COMFYUI_ROOT": {
        "description": "Root folder of the local ComfyUI install.",
        "default": "<path-to-your-ComfyUI>"
      },
      "COMFYUI_URL": {
        "description": "Local ComfyUI server URL.",
        "default": "http://127.0.0.1:8000"
      }
    }
  },
  "python_dependencies": {
    "requirements_file": "requirements.txt",
    "direct": ["Pillow"]
  },
  "external_dependencies": {
    "comfyui": {
      "vendored": false,
      "root_env": "COMFYUI_ROOT",
      "url_env": "COMFYUI_URL",
      "required_paths": [
        "input",
        "output",
        "models",
        "user/default/workflows",
        ".venv/Lib/site-packages/comfyui_workflow_templates_media_video/templates",
        "custom_nodes/Comfyui_TTP_Toolset"
      ],
      "required_custom_nodes": [
        "custom_nodes/Comfyui_TTP_Toolset"
      ],
      "required_models": [
        "models/checkpoints/ltx-2.3-22b-dev-fp8.safetensors",
        "models/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors",
        "models/loras/ltx-2.3-22b-distilled-lora-1.1_fro90_ceil72_condsafe.safetensors",
        "models/latent_upscale_models/ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
      ]
    }
  },
  "repo_assets": {
    "workflow_references": [
      "workflows/downloaded/LTX-2.3_FML2V_RuneXX_guider.local.json",
      "workflows/downloaded/LTX-2.3_ICLoRA_Motion_Track_Distilled.local.json",
      "workflows/downloaded/LTX_2_3_Replace_Anyone_in_Video_260523-4.json",
      "workflows/experimental/Yedp_3D_Director_Only.local.json",
      "workflows/experimental/Yedp_LTX-2.3_ICLoRA_Union_Control_Canny.local.json"
    ],
    "reference_images": [
      "assets/references/xiaomei_i2v_camera_test_street.png",
      "assets/references/xiaomei_front_portrait.png",
      "assets/references/truck_middle.png"
    ],
    "runtime_output_dirs": [
      "tasks/camera_lab_runs",
      "tasks/camera_lab_uploads"
    ]
  },
  "do_not_commit": [
    ".env",
    "tasks/camera_lab_runs/",
    "tasks/camera_lab_uploads/",
    "local ComfyUI install paths",
    "generated videos and uploaded media"
  ]
}
