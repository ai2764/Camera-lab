{
  "schema_version": 1,
  "project": {
    "name": "camera-lab",
    "summary": "Local Python HTTP server and static web UI for driving ComfyUI video workflows."
  },
  "runtime": {
    "os": ["windows", "macos", "linux"],
    "python": ">=3.10",
    "entrypoint": "server/camera_lab_server.py"
  },
  "commands": {
    "agent_setup": "python scripts/agent_setup.py",
    "install_python_dependencies": "python -m pip install -r requirements.txt",
    "install_node_dependencies": "npm install",
    "install_playwright_chromium": "npx playwright install chromium",
    "check_setup": "python scripts/check_setup.py",
    "install_workflows": "python scripts/install_workflows.py",
    "start": "python scripts/start_camera_lab.py --open",
    "stop": "python scripts/stop_camera_lab.py",
    "test": "python -m pytest -p no:cacheprovider tests/test_director_reference.py",
    "test_e2e": "npm run test:e2e",
    "python_syntax_check": "python -m py_compile server\\camera_lab_server.py",
    "frontend_app_syntax_check": "node --check frontend\\app.js",
    "frontend_photography_syntax_check": "node --check frontend\\photography.js",
    "windows_agent_setup": ".\\scripts\\agent_setup.ps1",
    "windows_check_setup": ".\\scripts\\check_setup.ps1",
    "windows_install_workflows": ".\\scripts\\install_workflows.ps1",
    "windows_start": ".\\scripts\\start_camera_lab.ps1 -Open",
    "windows_stop": ".\\scripts\\stop_camera_lab.ps1"
  },
  "agent_quickstart": [
    "Read AGENTS.md and dependency-manifest.json first.",
    "Run python scripts/agent_setup.py for repo-side dependencies.",
    "If ComfyUI is not installed, install it from the official ComfyUI docs before continuing.",
    "Edit .env so COMFYUI_ROOT points to a local ComfyUI install and COMFYUI_URL points to the running ComfyUI server.",
    "Run python scripts/install_workflows.py after COMFYUI_ROOT is valid.",
    "Run python scripts/check_setup.py and fix any MISSING item before starting the app.",
    "Run python -m pytest -p no:cacheprovider tests/test_director_reference.py before committing backend or workflow changes."
  ],
  "local_config": {
    "template": ".env.example",
    "ignored_file": ".env",
    "required_env": {
      "COMFYUI_ROOT": {
        "description": "Root folder of the local ComfyUI install.",
        "default": "<path-to-your-ComfyUI>"
      },
      "COMFYUI_URL": {
        "description": "Local ComfyUI server URL.",
        "default": "http://127.0.0.1:8000"
      }
    }
  },
  "python_dependencies": {
    "requirements_file": "requirements.txt",
    "direct": ["Pillow"]
  },
  "node_dependencies": {
    "package_file": "package.json",
    "lock_file": "package-lock.json",
    "dev": ["@playwright/test"],
    "required_for": ["browser smoke tests"]
  },
  "external_dependencies": {
    "comfyui": {
      "vendored": false,
      "root_env": "COMFYUI_ROOT",
      "url_env": "COMFYUI_URL",
      "install_docs": [
        "https://docs.comfy.org/installation/desktop/overview",
        "https://docs.comfy.org/installation/manual_install",
        "https://github.com/comfy-org/comfyui"
      ],
      "required_paths": [
        "input",
        "output",
        "models",
        "user/default/workflows",
        "custom_nodes/Comfyui_TTP_Toolset"
      ],
      "required_custom_nodes": [
        "custom_nodes/Comfyui_TTP_Toolset"
      ],
      "required_models": [
        "models/checkpoints/ltx-2.3-22b-dev-fp8.safetensors",
        "models/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors",
        "models/loras/ltx-2.3-22b-distilled-lora-1.1_fro90_ceil72_condsafe.safetensors",
        "models/latent_upscale_models/ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
      ]
    }
  },
  "without_comfyui": {
    "status": "limited_repo_only_mode",
    "can_do": [
      "install Camera Lab repo dependencies",
      "inspect and edit source files",
      "run Python unit tests that do not require live generation",
      "run frontend syntax checks"
    ],
    "cannot_do": [
      "install bundled workflows into ComfyUI",
      "pass python scripts/check_setup.py",
      "submit workflows for video generation",
      "verify model or custom-node availability"
    ]
  },
  "repo_assets": {
    "app_workflows": [
      "workflows/app/LTX-2.3_FML2V_RuneXX_guider.local.json",
      "workflows/app/ltx23_nag_i2v_extendcrop_general.json",
      "workflows/app/ltx23_nag_ia2v_extendcrop_general.json",
      "workflows/app/ltx_director_global_reference_mvp.json"
    ],
    "experimental_workflows": [
      "workflows/experimental/Yedp_3D_Director_Only.local.json",
      "workflows/experimental/Yedp_LTX-2.3_ICLoRA_Union_Control_Canny.local.json"
    ],
    "runtime_output_dirs": [
      "tasks/camera_lab_runs",
      "tasks/camera_lab_uploads"
    ]
  },
  "workflow_dropdown": [
    {
      "id": "i2v_official_local",
      "label": "LTX 2.3 NAG I2V Extendcrop",
      "mode": "i2v",
      "source": "workflows/app/ltx23_nag_i2v_extendcrop_general.json"
    },
    {
      "id": "flf_ttp_control",
      "label": "LTX 2.3 FLF TTP Control (2 images)",
      "mode": "flf",
      "source": "server builder: ltx23_ttp_flf"
    },
    {
      "id": "fml_two_segment_flf",
      "label": "LTX 2.3 FML (3 images, 2-stage TTP FLF)",
      "mode": "fml",
      "source": "server builder: ltx23_ttp_flf"
    },
    {
      "id": "fml_runexx_guider_local",
      "label": "LTX 2.3 FML RuneXX Guider Local (3 images)",
      "mode": "fml_native",
      "source": "workflows/app/LTX-2.3_FML2V_RuneXX_guider.local.json"
    },
    {
      "id": "ia2v_extendcrop",
      "label": "LTX 2.3 IA2V",
      "mode": "ia2v",
      "source": "workflows/app/ltx23_nag_ia2v_extendcrop_general.json"
    },
    {
      "id": "ltx_director_reference_mvp",
      "label": "LTX Director Global Reference MVP",
      "mode": "director_ref",
      "source": "workflows/app/ltx_director_global_reference_mvp.json"
    }
  ],
  "do_not_commit": [
    ".env",
    "tasks/",
    "local ComfyUI install paths",
    "generated videos and uploaded media"
  ]
}
